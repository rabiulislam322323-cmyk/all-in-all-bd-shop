<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Smart Shop BD | আপনার পছন্দের অনলাইন শপ</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: Arial, sans-serif;
}

body{
    background:#f5f5f5;
    color:#222;
}

/* HEADER */
header{
    background:#111;
    color:white;
    padding:15px 7%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:1000;
}

.logo{
    font-size:25px;
    font-weight:bold;
}

.logo span{
    color:#ffb703;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:20px;
}

.cart-btn{
    background:#ffb703;
    color:#111;
    border:none;
    padding:10px 15px;
    border-radius:20px;
    cursor:pointer;
    font-weight:bold;
}

/* HERO */
.hero{
    min-height:420px;
    padding:70px 10%;
    display:flex;
    align-items:center;
    background:linear-gradient(135deg,#111,#333);
    color:white;
}

.hero-content{
    max-width:650px;
}

.hero h1{
    font-size:45px;
    margin-bottom:15px;
}

.hero h1 span{
    color:#ffb703;
}

.hero p{
    font-size:18px;
    line-height:1.7;
    margin-bottom:25px;
}

.hero button{
    background:#ffb703;
    border:none;
    padding:15px 30px;
    font-size:16px;
    border-radius:30px;
    cursor:pointer;
    font-weight:bold;
}

/* CATEGORY */
.section{
    padding:55px 8%;
}

.title{
    text-align:center;
    font-size:30px;
    margin-bottom:35px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:18px;
}

.category{
    background:white;
    padding:25px 10px;
    text-align:center;
    border-radius:15px;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
    cursor:pointer;
    transition:.3s;
}

.category:hover{
    transform:translateY(-7px);
}

.category .icon{
    font-size:40px;
    margin-bottom:10px;
}

/* PRODUCTS */
.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:25px;
}

.product{
    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,.08);
    transition:.3s;
}

.product:hover{
    transform:translateY(-8px);
}

.product-img{
    height:180px;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#eee;
    font-size:70px;
}

.product-info{
    padding:18px;
}

.product-info h3{
    margin-bottom:10px;
}

.price{
    font-size:20px;
    font-weight:bold;
    margin-bottom:12px;
}

.old-price{
    text-decoration:line-through;
    color:#888;
    font-size:14px;
}

.product button{
    width:100%;
    padding:12px;
    border:none;
    background:#111;
    color:white;
    border-radius:8px;
    cursor:pointer;
    font-size:15px;
}

/* OFFER */
.offer{
    margin:20px 8%;
    padding:40px;
    text-align:center;
    border-radius:20px;
    background:#ffb703;
}

.offer h2{
    font-size:30px;
    margin-bottom:10px;
}

/* FOOTER */
footer{
    background:#111;
    color:white;
    padding:35px 8%;
    text-align:center;
    margin-top:40px;
}

.whatsapp{
    position:fixed;
    right:20px;
    bottom:20px;
    background:#25D366;
    color:white;
    width:60px;
    height:60px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    text-decoration:none;
    font-size:28px;
}

@media(max-width:700px){
    nav{
        display:none;
    }

    .hero h1{
        font-size:32px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">SMART <span>SHOP</span> BD</div>

    <nav>
        <a href="#home">হোম</a>
        <a href="#products">পণ্য</a>
        <a href="#offer">অফার</a>
    </nav>

    <button class="cart-btn">
        🛒 কার্ট (<span id="cartCount">0</span>)
    </button>
</header>


<!-- HERO SECTION -->
<section class="hero" id="home">
    <div class="hero-content">
        <h1>আপনার পছন্দের সবকিছু <span>একটি Shop-এ!</span></h1>

        <p>
            ইলেকট্রনিক্স, গ্যাজেট, খেলনা, চকলেট এবং আরও অনেক পণ্য—
            সেরা দামে অর্ডার করুন আজই।
        </p>

        <button onclick="document.getElementById('products').scrollIntoView()">
            🛍️ এখনই শপিং করুন
        </button>
    </div>
</section>


<!-- CATEGORY -->
<section class="section">
    <h2 class="title">জনপ্রিয় ক্যাটাগরি</h2>

    <div class="categories">
        <div class="category">
            <div class="icon">⚡</div>
            <b>Electric</b>
        </div>

        <div class="category">
            <div class="icon">📱</div>
            <b>Gadget</b>
        </div>

        <div class="category">
            <div class="icon">🎧</div>
            <b>Electronic</b>
        </div>

        <div class="category">
            <div class="icon">🧸</div>
            <b>Toys</b>
        </div>

        <div class="category">
            <div class="icon">🍫</div>
            <b>Chocolate</b>
        </div>

        <div class="category">
            <div class="icon">💪</div>
            <b>Supplement</b>
        </div>
    </div>
</section>


<!-- PRODUCTS -->
<section class="section" id="products">

<h2 class="title">🔥 আমাদের জনপ্রিয় পণ্য</h2>

<div class="products">

    <div class="product">
        <div class="product-img">🎧</div>
        <div class="product-info">
            <h3>Wireless Headphone</h3>
            <div class="price">৳ 1,290 <span class="old-price">৳ 1,800</span></div>
            <button onclick="addCart('Wireless Headphone',1290)">কার্টে যোগ করুন</button>
        </div>
    </div>

    <div class="product">
        <div class="product-img">⌚</div>
        <div class="product-info">
            <h3>Smart Watch</h3>
            <div class="price">৳ 1,990 <span class="old-price">৳ 2,500</span></div>
            <button onclick="addCart('Smart Watch',1990)">কার্টে যোগ করুন</button>
        </div>
    </div>

    <div class="product">
        <div class="product-img">💡</div>
        <div class="product-info">
            <h3>LED Smart Light</h3>
            <div class="price">৳ 450 <span class="old-price">৳ 650</span></div>
            <button onclick="addCart('LED Smart Light',450)">কার্টে যোগ করুন</button>
        </div>
    </div>

    <div class="product">
        <div class="product-img">🧸</div>
        <div class="product-info">
            <h3>Kids Toy</h3>
            <div class="price">৳ 750 <span class="old-price">৳ 1,000</span></div>
            <button onclick="addCart('Kids Toy',750)">কার্টে যোগ করুন</button>
        </div>
    </div>

    <div class="product">
        <div class="product-img">🍫</div>
        <div class="product-info">
            <h3>Premium Chocolate</h3>
            <div class="price">৳ 350</div>
            <button onclick="addCart('Premium Chocolate',350)">কার্টে যোগ করুন</button>
        </div>
    </div>

    <div class="product">
        <div class="product-img">💪</div>
        <div class="product-info">
            <h3>Nutrition Supplement</h3>
            <div class="price">৳ 1,500</div>
            <button onclick="addCart('Nutrition Supplement',1500)">কার্টে যোগ করুন</button>
        </div>
    </div>

</div>
</section>


<!-- OFFER -->
<section class="offer" id="offer">
    <h2>🔥 আজকের বিশেষ অফার!</h2>
    <p>নির্বাচিত পণ্যে আকর্ষণীয় ডিসকাউন্ট। সীমিত সময়ের জন্য!</p>
</section>


<footer>
    <h2>SMART SHOP BD</h2>
    <p>বিশ্বাসের সাথে অনলাইন শপিং করুন ❤️</p>
    <br>
    <p>© 2026 সকল অধিকার সংরক্ষিত</p>
</footer>


<!-- WHATSAPP BUTTON -->
<a class="whatsapp"
href="https://wa.me/8801XXXXXXXXX"
target="_blank">
💬
</a>


<script>
let cart = [];

function addCart(product, price){

    cart.push({
        product: product,
        price: price
    });

    document.getElementById("cartCount").innerText = cart.length;

    alert(product + " কার্টে যোগ করা হয়েছে!");
}
</script>

</body>
</html>
